# Slack 앱 > Install App > Bot User OAuth Token
SLACK_BOT_TOKEN=
# Slack 앱 > Basic Information > App-Level Tokens (connections:write)
SLACK_APP_TOKEN=

# Multica 접속 정보. 비우면 multica CLI 설정(~/.multica/config.json)을 쓴다
MULTICA_SERVER_URL=
MULTICA_APP_URL=
MULTICA_WORKSPACE_ID=
MULTICA_TOKEN=

# unfurl: "맡기기" 버튼 대상(JSON 배열, 최대 4개). 비우면 버튼 없음
AGENT_TARGETS=

# chat: 대화할 Multica 에이전트 ID. 비우면 chat 기능을 켜지 않는다
CHAT_AGENT_ID=
# chat: 처리 중 반응 이모지(빈 값이면 끔), 답 대기 최대 시간(분)
CHAT_TYPING_EMOJI=eyes
CHAT_REPLY_TIMEOUT_MIN=30

LOG_LEVEL=info
